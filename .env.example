# ── Adresses ─────────────────────────────────────────────────────
PORT_BACKEND=8101
BACKEND_URL=http://localhost:8101
PORT_FRONTEND=4216
FRONTEND_URL=http://localhost:4216

# ── Base de données ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devdb
DB_SCHEMA=peripheriques
DB_USER=devuser
DB_PASSWORD=CHANGE_ME

# ── Django ───────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=*

# ── Reverse proxy (Caddy) ────────────────────────────────────────
SCRIPT_NAME=/peripheriques-api

# ── SSO Keycloak ─────────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=peripheriques
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/ssolab
# Client public (SPA Angular) — Keycloak → Clients → peripheriques → Access type : Public
# Valid redirect URIs : http://localhost:4216/*

# ── URLs (propagées automatiquement par reset_url.sh) ────────────
PORT_KEYCLOAK=8080
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
KEYCLOAK_URL=http://192.168.1.X:8080
KEYCLOAK_PUBLIC_URL=http://VOTRE_IP_WAN:8080

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
DOMAIN=CHANGE_ME

# ── Périphériques / brique lab-media (lab-media/API.md) ───────────────────────
PERIPHERIQUES_ADMIN_GROUPS=developers
# API de contrôle de lab-media-auth (réseau dev-net) : état des chemins, sessions,
# expulsion ET relecture — une seule base. Le backend ne parle plus à MediaMTX.
MEDIA_API_URL=http://lab-media-auth:9100
# Identifiants de CONTRÔLE de l'app auprès de lab-media. Mêmes valeurs que
# LAB_MEDIA_APP_PERIPHERIQUES_CONTROL_USER / _PASSWORD dans lab-media/.env.
MEDIA_INTERNAL_USER=backend
MEDIA_INTERNAL_PASSWORD=CHANGE_ME
# Clé que lab-media présente au hook de lecture /api/media-auth/?key=…
# Même valeur que LAB_MEDIA_APP_PERIPHERIQUES_HOOK_KEY dans lab-media/.env.
MEDIA_HOOK_KEY=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_ID=peripheriques-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Clés SUPPRIMÉES à la bascule vers lab-media (elles vivent désormais dans lab-media/.env,
# ou n'existent plus) : MEDIA_PLAYBACK_URL, MEDIA_PUBLISH_USER, MEDIA_PUBLISH_PASSWORD,
# MEDIA_DEVICE_VIDEO, MEDIA_DEVICE_AUDIO, MEDIA_WEBRTC_PORT, MEDIA_WEBRTC_HOSTS.
